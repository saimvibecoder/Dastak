# From Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC. Add it in Vercel > Settings > Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=
# Your live address, used in QR codes and login links
NEXT_PUBLIC_SITE_URL=https://dastak.vercel.app
# Your WhatsApp number for the sales page "Book a walkthrough" button, digits only
NEXT_PUBLIC_SALES_WHATSAPP=
